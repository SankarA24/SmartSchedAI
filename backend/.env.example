# Port the Express server listens on (frontend expects 5000)
PORT=5000
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/smartschedai
# Secret used to sign JWTs; use a long random string in real deployments
JWT_SECRET=change-me
# Google Gemini API key; leave empty to always use the local fallback scheduler
GOOGLE_API_KEY=
# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
